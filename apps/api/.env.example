# DinePosAI - Backend Environment Variables Configuration

PORT=4000
NODE_ENV=development

# JWT Secret for access/refresh tokens
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-chars

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend Email Configuration
RESEND_API_KEY=re_...
SENDER_EMAIL_DOMAIN=noreply.dineposai.com

# Analytics Configuration
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# Frontend Origin URL
FRONTEND_URL=http://localhost:3000
